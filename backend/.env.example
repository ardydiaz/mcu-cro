NODE_ENV=development
PORT=2002
FRONTEND_URL=http://localhost:2001
# Reverse proxies in front of the API (0 locally; 1 behind nginx/IIS; more if also behind Cloudflare).
# Lets rate limits and audit logs see the real client IP.
TRUST_PROXY=0
# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mcu_cro
DB_USER=root
DB_PASSWORD=

# Generate each with: npm run secret
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# How long a sign-in lasts before Microsoft 365 sign-in is required again.
JWT_REFRESH_EXPIRES_IN=8h
JWT_ISSUER=mcu-cro-api

# Microsoft 365 / Entra ID app registration (see docs/m365-login.md)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REDIRECT_URI=http://localhost:2001/api/auth/m365/callback
